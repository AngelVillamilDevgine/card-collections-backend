# Copiar como .env en el servidor. No se versiona: el de producción lo escribe el deploy.

# Dónde escucha. Detrás del proxy alcanza con la interfaz local: nadie llega directo.
PORT=8787
DBZ_DIRECCION=127.0.0.1

# El archivo de la base. Vive fuera del código para que un deploy no lo toque.
DBZ_BASE=/opt/dbz-api/datos/coleccion.db

# Qué front tiene permiso de pedirle a esta API. Separados por coma, sin barra al final.
# Sin esto el navegador corta los pedidos por CORS.
DBZ_ORIGENES=https://card-collections-frontend.pages.dev

DBZ_LOG=info
