# Para correr local. En el servidor nada de esto es un archivo: la URL del MySQL entra
# como secret del swarm y el resto como environment del stack.

# La base. Local, un MySQL descartable en Docker:
#   docker run -d --name dbz-mysql -e MYSQL_ROOT_PASSWORD=prueba \
#     -e MYSQL_DATABASE=dbz_cromeros -p 3307:3306 mysql:8
DBZ_MYSQL_URL=mysql://root:prueba@127.0.0.1:3307/dbz_cromeros

# Qué front tiene permiso de pedirle a esta API. Separados por coma, sin barra al final.
# Sin esto el navegador corta los pedidos por CORS.
DBZ_ORIGENES=http://localhost:5173

PORT=8787
DBZ_LOG=info
